# ---- Server ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/
DB_NAME=buffer_oauth_demo
CLIENT_URL=http://localhost:5173

# ---- Your website's own login (JWT) ----
# Must be the SAME secret your existing login uses to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Buffer OAuth ----
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=http://localhost:4000/api/buffer/callback
# Ask only for what you need. offline_access is required to get a refresh token.
BUFFER_SCOPES=account:read posts:read posts:write ideas:read ideas:write offline_access

# ---- Token encryption (AES-256-GCM) ----
# Generate with:  npm run gen-key
TOKEN_ENCRYPTION_KEY=


# ---- Cloudinary for media uploads ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=buffer-connect

# ---- Recurring posts ----
RECURRING_WORKER=true

# ---- AI writing helper (Google Gemini, free tier) ----
# Create a free key at https://aistudio.google.com/apikey . Leave empty to switch the AI chat off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_MESSAGES_PER_HOUR=20
AI_MESSAGES_PER_DAY=300
